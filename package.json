{
  "name": "vue-echo-editor",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "A modern AI-powered WYSIWYG rich-text editor for Vue, based on Tiptap and shadcn-vue",
  "author": "SEED<hello.mr.lji@gmail.com>",
  "homepage": "https://github.com/kemboi22/vue-echo-editor/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kemboi22/vue-echo-editor/"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "vite",
    "examples": "pnpm build:lib && pnpm --dir ./examples run dev",
    "examples:dev": "pnpm --dir ./examples run dev",
    "build:lib": "vite build",
    "build:examples": "pnpm build:lib && pnpm --dir ./examples run build",
    "preview": "vite preview",
    "git-commit": "git-cz",
    "type:check": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "push": "pnpm build:lib && pnpm publish --no-git-checks --registry https://registry.npmjs.org/",
    "prepare": "husky",
    "test": "vitest run",
    "docs:dev": "pnpm --dir ./docs run dev",
    "docs:build": "pnpm --dir ./docs run build",
    "docs:generate": "pnpm --dir ./docs run generate"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "keywords": [
    "echo editor",
    "WYSIWYG",
    "vue",
    "vue.js",
    "typescript",
    "tiptap",
    "editor",
    "shadcn ui",
    "wysiwyg",
    "rich text",
    "markdown"
  ],
  "main": "./lib/echo-editor.cjs",
  "module": "./lib/echo-editor.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/echo-editor.js",
      "require": "./lib/echo-editor.cjs"
    },
    "./collaboration": {
      "types": "./lib/collaboration.d.ts",
      "import": "./lib/collaboration.js",
      "require": "./lib/collaboration.cjs"
    },
    "./style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lucide/vue": "^1.48.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-blockquote": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-bubble-menu": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-strike": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hotkeys-js": "^4.0.8",
    "prism-code-editor": "^5.4.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.7",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "^4.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.11",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.7",
    "vue": "^3.5.0",
    "yjs": "^13.6.0"
  },
  "type": "module",
  "peerDependenciesMeta": {
    "@tiptap/extension-collaboration": {
      "optional": true
    },
    "@tiptap/extension-collaboration-caret": {
      "optional": true
    },
    "@tiptap/y-tiptap": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  }
}
